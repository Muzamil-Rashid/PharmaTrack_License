# These don't get used as a file on Vercel -- copy each of these into
# Vercel: Project -> Settings -> Environment Variables. Listed here just as
# a reference for names and where each value comes from.

# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste_the_service_role_key_here

# Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=paste_your_key_secret_here

# Razorpay Dashboard -> Settings -> Webhooks
# (create one pointing at https://your-project.vercel.app/api/webhook/razorpay,
# subscribed to the payment.captured event, then copy the secret it gives you)
RAZORPAY_WEBHOOK_SECRET=paste_your_webhook_secret_here

# Open your license_generator.html file, copy the exact PRIVATE_KEY_B64
# value, paste it here. This is your real signing key.
LICENSE_PRIVATE_KEY_B64=paste_your_pkcs8_base64_private_key_here

# ---------- Email notifications ----------
# The Gmail account that SENDS both the customer email and the admin
# notification. Requires an "App Password", not your normal Gmail password:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      (choose "Mail" as the app type) -- it gives you a 16-character code.
GMAIL_USER=your.sending.address@gmail.com
GMAIL_APP_PASSWORD=paste_the_16_char_app_password_here

# Where the internal "new license issued" copy is sent. This looked like
# the email your Supabase project is registered under
# (muzamilrashid1318@gmail.com going by the dashboard) -- confirm and
# change if that's not the inbox you want these in.
ADMIN_NOTIFICATION_EMAIL=muzamilrashid1318@gmail.com

# Shown in the customer email's "need help" line. Keep in sync with the
# SUPPORT_EMAIL constant in index.html / activate.html / terms.html.
SUPPORT_EMAIL=MuzamilMatta63@gmail.com
